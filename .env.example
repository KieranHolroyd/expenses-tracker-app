# Turso database credentials.
#
#   turso db create ledgerly
#   turso db show ledgerly --url
#   turso db tokens create ledgerly
#
# Leave both unset in development and the app falls back to a local SQLite file
# at data/expenses.db. They are required in production — the app refuses to boot
# without TURSO_DATABASE_URL rather than silently writing to disposable storage.
TURSO_DATABASE_URL=libsql://ledgerly-yourname.turso.io
TURSO_AUTH_TOKEN=

# Public URL, required by the Node adapter behind a proxy.
ORIGIN=http://localhost:3000

# OpenRouter, used by Auto-categorise on the Expenses page. Leave unset and the
# button is hidden. Expense names and amounts are sent to OpenRouter when it runs,
# including for passcode-protected profiles.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id. Defaults to openai/gpt-5.6-terra.
OPENROUTER_MODEL=
