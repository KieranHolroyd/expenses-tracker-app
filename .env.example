# Turso database credentials.
#
#   turso db create ledgerly
#   turso db show ledgerly --url
#   turso db tokens create ledgerly
#
# Leave both unset in development and the app falls back to a local SQLite file
# at data/expenses.db. They are required in production — the app refuses to boot
# without TURSO_DATABASE_URL rather than silently writing to disposable storage.
TURSO_DATABASE_URL=libsql://ledgerly-yourname.turso.io
TURSO_AUTH_TOKEN=

# Public URL, required by the Node adapter behind a proxy — and the only thing
# sign-in needs. Ledgerly registers itself with Holroyd ID on boot, deriving the
# provider from this (ledgerly.holroydnet.uk implies auth.holroydnet.uk) and
# building its redirect URI from it. Leave it unset in development and the app
# runs with a stub session instead; in production, no ORIGIN means no sign-in.
ORIGIN=http://localhost:3000

# Everything below is optional. Sign-in works with none of it set.
#
# Point at a provider somewhere other than auth.<your parent domain>.
# AUTH_ISSUER_URL=https://auth.holroydnet.uk
#
# Ask for a confidential client (one with a secret) instead of the public,
# PKCE-only client self-registration hands back. Must match APP_REGISTRATION_TOKEN
# on the auth service. Only needed if you specifically want a secret.
# AUTH_REGISTRATION_TOKEN=
#
# Skip self-registration entirely and use a client someone made by hand. These
# two win over anything registration would produce.
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=

# OpenRouter, used by Auto-categorise on the Expenses page. Leave unset and the
# button is hidden. Expense names and amounts are sent to OpenRouter when it runs,
# including for passcode-protected profiles.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id. Defaults to openai/gpt-5.6-terra.
OPENROUTER_MODEL=
